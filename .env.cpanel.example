# Copy to .env.cpanel (gitignored) and run: make frontend-build-cpanel-prod
BACKEND_INTERNAL_URL=https://api.posutki.by
NEXT_PUBLIC_API_URL=https://api.posutki.by/api
NEXT_PUBLIC_SITE_URL=https://posutki.by
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_GEOCODER_API_KEY=
REVALIDATION_SECRET=

# cPanel Node.js app env (runtime, not build):
# NODE_OPTIONS=--disable-wasm-trap-handler

# cPanel / CloudLinux build (cloudlinux-selector run-script build:low-memory):
# CPANEL_BUILD_HEAP_MB=2048
# CPANEL_BUILD_CLEAN=1
# Не ставьте 2560+ на 4 GB LVE — SWC не загрузится (mmap). heap OOM → 2176, SWC OOM → 1920.
