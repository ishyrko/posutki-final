{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Отклонение объявления{% endblock %}

{% block main %}
    <div class="content-body" style="max-width:640px;">
        <p class="text-secondary mb-2"><strong>Объявление:</strong> {{ property.title }} (#{{ property.id }})</p>
        <p class="text-secondary mb-4">Укажите причину отклонения — она будет отправлена владельцу.</p>

        <form method="post" action="{{ app.request.requestUri }}" class="ea-form">
            <div class="form-group mb-3">
                <label class="form-control-label required" for="moderationComment">Причина отклонения</label>
                <textarea
                    id="moderationComment"
                    name="moderationComment"
                    class="form-control{% if error %} is-invalid{% endif %}"
                    rows="4"
                    required
                    placeholder="Опишите, что нужно исправить"
                >{{ comment|default('') }}</textarea>
                {% if error %}
                    <div class="invalid-feedback d-block">{{ error }}</div>
                {% endif %}
            </div>
            <button type="submit" class="btn btn-danger">Отклонить объявление</button>
            <a href="{{ cancelUrl }}" class="btn btn-secondary ms-2">Отмена</a>
        </form>
    </div>
{% endblock %}
