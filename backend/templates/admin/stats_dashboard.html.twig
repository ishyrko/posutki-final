{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Статистика объявлений{% endblock %}

{% block main %}
    <div class="content-body">
        <form method="get" action="{{ path('admin') }}" class="d-flex flex-wrap gap-2 align-items-center mb-4">
        <select name="period" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
            <option value="0" {% if filters.period == 0 %}selected{% endif %}>Сегодня</option>
            <option value="-1" {% if filters.period == -1 %}selected{% endif %}>Вчера</option>
            <option value="7" {% if filters.period == 7 %}selected{% endif %}>7 дней</option>
            <option value="30" {% if filters.period == 30 %}selected{% endif %}>30 дней</option>
            <option value="90" {% if filters.period == 90 %}selected{% endif %}>90 дней</option>
        </select>

        <select name="type" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
            <option value="" {% if filters.type is empty %}selected{% endif %}>Все типы</option>
            <option value="apartment" {% if filters.type == 'apartment' %}selected{% endif %}>Квартиры</option>
            <option value="house" {% if filters.type == 'house' %}selected{% endif %}>Дома</option>
        </select>

        <select name="cityId" class="form-select form-select-sm" style="min-width:220px; max-width:320px;" onchange="this.form.submit()" {% if filters.type != 'apartment' %}hidden{% endif %}>
            <option value="" {% if filters.cityId is empty %}selected{% endif %}>Вся Беларусь</option>
            {% for city in apartmentCities %}
                <option value="{{ city.id }}" {% if filters.cityId == city.id %}selected{% endif %}>{{ city.name }}</option>
            {% endfor %}
        </select>

        <select name="regionId" class="form-select form-select-sm" style="min-width:220px; max-width:320px;" onchange="this.form.submit()" {% if filters.type != 'house' %}hidden{% endif %}>
            <option value="" {% if filters.regionId is empty %}selected{% endif %}>Вся Беларусь</option>
            {% for region in houseRegions %}
                <option value="{{ region.id }}" {% if filters.regionId == region.id %}selected{% endif %}>{{ region.name }}</option>
            {% endfor %}
        </select>
        </form>

        <p class="text-secondary mb-4">
            Агрегированная статистика по
            {% if filters.type == 'apartment' %}квартирам{% elseif filters.type == 'house' %}домам{% else %}всем объявлениям{% endif %}
            {% if selectedCityName %}в г. {{ selectedCityName }}{% elseif selectedRegionName %}в {{ selectedRegionName }}{% else %}по всей Беларуси{% endif %}
            {% if stats.period == 0 %}за сегодня{% elseif stats.period == -1 %}за вчера{% else %}за последние {{ stats.period }} дн.{% endif %}
            <span class="text-muted">· {{ stats.propertiesCount }} объявл.</span>
        </p>

        <div class="row mb-4">
            <div class="col-sm-6 col-lg-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">Просмотры объявлений</div>
                        <div class="fs-2 fw-bold">{{ stats.totals.views|number_format(0, '.', ' ') }}</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">Показы телефона</div>
                        <div class="fs-2 fw-bold">{{ stats.totals.phoneViews|number_format(0, '.', ' ') }}</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">Добавления в избранное</div>
                        <div class="fs-2 fw-bold">{{ stats.totals.favorites|number_format(0, '.', ' ') }}</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">Полученные сообщения</div>
                        <div class="fs-2 fw-bold">{{ stats.totals.messages|number_format(0, '.', ' ') }}</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-secondary small mb-1">Заявки на бронирование</div>
                        <div class="fs-2 fw-bold">{{ stats.totals.bookingInquiries|number_format(0, '.', ' ') }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header fw-semibold">Динамика просмотров</div>
            <div class="card-body">
                <canvas id="viewsChart" height="100"></canvas>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header fw-semibold">Обращения и избранное по дням</div>
            <div class="card-body">
                <canvas id="contactsChart" height="100"></canvas>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">По дням</div>
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th class="text-end">Просмотры</th>
                            <th class="text-end">Телефон</th>
                            <th class="text-end">Сообщения</th>
                            <th class="text-end">Бронирование</th>
                            <th class="text-end">Избранное</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in stats.daily|reverse %}
                            <tr>
                                <td>{{ row.date|date('d.m.Y') }}</td>
                                <td class="text-end">{{ row.views|number_format(0, '.', ' ') }}</td>
                                <td class="text-end">{{ row.phoneViews|number_format(0, '.', ' ') }}</td>
                                <td class="text-end">{{ row.messages|number_format(0, '.', ' ') }}</td>
                                <td class="text-end">{{ row.bookingInquiries|number_format(0, '.', ' ') }}</td>
                                <td class="text-end">{{ row.favorites|number_format(0, '.', ' ') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const dailyData = {{ stats.daily|json_encode|raw }};
        const labels = dailyData.map((row) => {
            const parts = row.date.split('-');
            return `${parts[2]}.${parts[1]}`;
        });

        new Chart(document.getElementById('viewsChart'), {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    label: 'Просмотры',
                    data: dailyData.map((row) => row.views),
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.1)',
                    tension: 0.25,
                    fill: true,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } },
                },
            },
        });

        new Chart(document.getElementById('contactsChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    {
                        label: 'Показы телефона',
                        data: dailyData.map((row) => row.phoneViews),
                        backgroundColor: '#2563eb',
                    },
                    {
                        label: 'Сообщения',
                        data: dailyData.map((row) => row.messages),
                        backgroundColor: '#7c3aed',
                    },
                    {
                        label: 'Заявки на бронирование',
                        data: dailyData.map((row) => row.bookingInquiries),
                        backgroundColor: '#059669',
                    },
                    {
                        label: 'В избранное',
                        data: dailyData.map((row) => row.favorites),
                        backgroundColor: '#64748b',
                    },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } },
                },
            },
        });
    </script>
{% endblock %}
